# ==========================================================
# HANGOVER — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================================

# ---- Server ----
PORT=4000
NODE_ENV=production
APP_BASE_URL=https://hangoverevents.gh
ADMIN_PANEL_URL=https://hangoverevents.gh/admin.html

# ---- Database ----
# Path to the SQLite database file (auto-created on first run)
DATABASE_PATH=./database/hangover.db

# ---- Auth / Sessions ----
# Generate a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=12h

# ---- Admin bootstrap (used only by scripts/createAdmin.js) ----
ADMIN_EMAIL=admin@hangoverevents.gh
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Event Admin

# ---- Hubtel Payment Integration ----
# Get these from your Hubtel merchant dashboard.
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_NUMBER=your_hubtel_merchant_account_number
HUBTEL_CALLBACK_URL=https://your-domain.com/api/payments/hubtel/callback
HUBTEL_RETURN_URL=https://your-domain.com/payment-complete.html
HUBTEL_CANCELLATION_URL=https://your-domain.com/index.html
HUBTEL_ENVIRONMENT=sandbox

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="HANGOVER Events <tickets@hangoverevents.gh>"

# ---- CORS ----
# Comma-separated list of allowed origins for the public site + admin panel
ALLOWED_ORIGINS=https://hangoverevents.gh,https://www.hangoverevents.gh
