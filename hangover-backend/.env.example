# ==========================================================
# HANGOVER — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================================

# ---- Server ----
PORT=4000
NODE_ENV=production
APP_BASE_URL=https://hangoverevent.com
ADMIN_PANEL_URL=https://hangoverevent.com/admin.html

# ---- Database ----
# Path to the SQLite database file (auto-created on first run)
DATABASE_PATH=./database/hangover.db

# ---- Auth / Sessions ----
# Generate a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=12h

# ---- Admin bootstrap (used only by scripts/createAdmin.js) ----
ADMIN_EMAIL=admin@hangoverevents.gh
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Event Admin

# ---- Manual Mobile Money Payments ----
# Regular ticket payments go to the ticket payment account.
TICKET_MOMO_NETWORK=MTN
TICKET_MOMO_NUMBER=replace_with_ticket_payment_number
TICKET_MOMO_NAME=replace_with_ticket_account_name

# Table reservation payments go directly to the manager's account.
TABLE_MOMO_NETWORK=MTN
TABLE_MOMO_NUMBER=replace_with_manager_momo_number
TABLE_MOMO_NAME=replace_with_manager_account_name

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="HANGOVER Events <tickets@hangoverevents.gh>"

# ---- CORS ----
# Comma-separated list of allowed origins for the public site + admin panel
ALLOWED_ORIGINS=https://hangoverevent.com,https://www.hangoverevents.gh
